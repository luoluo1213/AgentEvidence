# API
APP_NAME=AgentEvidence
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RESEARCH_UPLOAD_DIR=data/uploads
RESEARCH_PDF_MAX_BYTES=20971520

# Chat / LLM provider (OpenAI-compatible; placeholders only)
AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=replace-with-server-side-key
OPENAI_MODEL=replace-with-chat-model
AI_TIMEOUT_SECONDS=120

# Independent embedding provider (OpenAI-compatible)
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-with-embedding-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=30

# Persistence
DATABASE_URL=sqlite:///./data/agentevidence.db
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=agentevidence_knowledge
CHROMA_SNAPSHOT_DIR=data/chroma-snapshots
KNOWLEDGE_VECTOR_ENABLED=true
KNOWLEDGE_VECTOR_REQUIRED=false

# Retrieval
KNOWLEDGE_TOP_K=4
KNOWLEDGE_CANDIDATE_K=16
KNOWLEDGE_HYBRID_VECTOR_WEIGHT=0.65
KNOWLEDGE_HYBRID_BM25_WEIGHT=0.35
KNOWLEDGE_RERANK_ENABLED=true
RESEARCH_RETRIEVAL_TOP_K=5
RESEARCH_MAX_EVIDENCE_ITEMS=6

# Harness budgets
RESEARCH_MAX_PROVIDER_RETRIES=2
RESEARCH_MAX_DRAFT_REPAIRS=1
RESEARCH_MAX_RETRIEVAL_REPAIRS=0
RESEARCH_MAX_TOTAL_LLM_CALLS=24
RESEARCH_RETRY_BACKOFF_SECONDS=0.4
